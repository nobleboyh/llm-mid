# GateMid — API Keys
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GATEWAY_MASTER_KEY=sk-local-dev-key

# Hugging Face token (optional — speeds up model downloads)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token

# ── Local AI Providers ──────────────────────────────────────────────────
# Uncomment and configure if using local inference servers via GateMid.

# Ollama (default port: 11434)
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODEL=llama3

# llama.cpp (default port: 8080)
# LLAMACPP_API_BASE=http://localhost:8080
# LLAMACPP_MODEL=llama-3.2-3b

# LM Studio (default port: 1234)
# LMSTUDIO_API_BASE=http://localhost:1234
# LMSTUDIO_MODEL=model

# oMLX — Apple Silicon optimized (default port: 8000)
# OMLX_API_KEY=your-omlx-api-key        # required — oMLX enforces API-key auth
# OMLX_API_BASE=http://host.docker.internal:8000
# OMLX_MODEL=Qwen3.5-9B-MLX-4bit       # exact model your oMLX server serves

# Note: defaults already target host.docker.internal so the Docker proxy can
# reach local servers running on the host. If you run the local server inside
# Docker instead, switch back to localhost, e.g.:
# OLLAMA_API_BASE=http://localhost:11434
