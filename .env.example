# GateMid — API Keys
GEMINI_API_KEY=your-gemini-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GATEWAY_MASTER_KEY=sk-local-dev-key

# Hugging Face token (optional — speeds up model downloads)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your-hf-token

# ── Local AI Providers ──────────────────────────────────────────────────
# Uncomment and configure if using local inference servers via GateMid.
# Defaults already target host.docker.internal so the Docker proxy can
# reach local servers running on the host.

# Ollama (default port: 11434)
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_MODEL=                # exact — run `ollama list`

# llama.cpp (default port: 8080)
# LLAMACPP_API_BASE=http://host.docker.internal:8080
# LLAMACPP_MODEL=              # exact — see server startup output

# LM Studio (default port: 1234)
# LMSTUDIO_API_BASE=http://host.docker.internal:1234
# LMSTUDIO_MODEL=              # exact — loaded model in LM Studio UI

# oMLX — Apple Silicon optimized (default port: 8000)
# OMLX_API_KEY=your-omlx-api-key        # required — oMLX enforces API-key auth
# OMLX_API_BASE=http://host.docker.internal:8000
# OMLX_MODEL=                 # exact model your oMLX server serves

# If you run a local server inside the same Docker network as GateMid
# instead, switch its *_API_BASE back to localhost, e.g.:
# OLLAMA_API_BASE=http://localhost:11434
